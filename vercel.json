{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "index.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "setup.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "logout.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "forgot_password.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "process_forgot_password.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "process_reset_password.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "reset_password.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "modules/**/*.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "includes/**/*.php": {
      "runtime": "vercel-community/php@0.7.1"
    },
    "config/**/*.php": {
      "runtime": "vercel-community/php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.png)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.jpg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.svg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.php)(\\?.*)?$",
      "dest": "/$1$2"
    },
    {
      "src": "^/$",
      "dest": "/index.php"
    }
  ]
}
