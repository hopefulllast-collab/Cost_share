{
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.9.0" },
    { "src": "setup.php", "use": "vercel-php@0.9.0" },
    { "src": "logout.php", "use": "vercel-php@0.9.0" },
    { "src": "forgot_password.php", "use": "vercel-php@0.9.0" },
    { "src": "process_forgot_password.php", "use": "vercel-php@0.9.0" },
    { "src": "process_reset_password.php", "use": "vercel-php@0.9.0" },
    { "src": "reset_password.php", "use": "vercel-php@0.9.0" },
    { "src": "api/*.php", "use": "vercel-php@0.9.0" },
    { "src": "modules/**/*.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.png)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.jpg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.svg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.php)(\\?.*)?$",
      "dest": "/$1$2"
    },
    {
      "src": "^/$",
      "dest": "/index.php"
    }
  ]
}
